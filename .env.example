# Copy to .env (gitignored) and fill in. docker-compose.yaml reads this file automatically.

# HMAC signing key for JWTs. Compose refuses to start without it.
# Generate a fresh one per environment - never reuse the dev fallback from
# application-dev.yml, which is committed and therefore public:
#   openssl rand -hex 32
JWT_SECRET=your_local_jwt_secret_here

POSTGRES_PASSWORD=your_local_database_password

# Origin the browser calls the API from. Defaults to the Vite dev server.
# In deployment this must be the real frontend origin (e.g. https://your-app.vercel.app),
# otherwise every request is blocked by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173
