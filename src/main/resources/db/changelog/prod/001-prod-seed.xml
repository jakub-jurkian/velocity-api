        <sql>
            INSERT INTO reservations (id, start_date, end_date, total_cost, status, cancellation_reason,
                                      created_at, version, user_id, bike_instance_id)
            SELECT s.id,
                   s.start_date,
                   s.start_date + s.days,
                   (s.days * CASE WHEN s.days > 14 THEN 15.00
                                  WHEN s.days > 7 THEN 20.00
                                  ELSE 25.00 END)::numeric(38, 2),
                   s.status,
                   NULL::varchar(255),
                   -- A PENDING row has to be born now. cancelStalePendingReservations sweeps every
                   -- 5 minutes for anything PENDING older than 30 minutes, so a back-dated
                   -- created_at would be CANCELLED before anyone reached the login screen.
                   CASE WHEN s.status = 'PENDING' THEN now()
                        ELSE ((s.start_date - 5)::timestamp + INTERVAL '9 hours 30 minutes') AT TIME ZONE 'Europe/Warsaw'
                   END,
                   0,
                   s.user_id,
                   s.bike_id
            FROM (SELECT t.id::uuid AS id,
                         CURRENT_DATE + t.start_off AS start_date,
                         t.days   AS days,
                         t.status AS status,
                         t.user_id::uuid AS user_id,
                         t.bike_id::uuid AS bike_id
                  FROM (VALUES
                      -- id, start_off (days from today), days, status, user, bike
                      -- Bob, under way on DEMO-1: this bike is out with a rider right now.
                      ('b0000000-0000-4000-8000-000000000001', -3,  7, 'CONFIRMED', '4f2c9a1b-7e8d-43c2-9f1e-5a8b7c2d3e4f', '00000000-0000-4000-8000-000000000001'),
                      -- Bob, starts in 2 days on DEMO-2: a conflict that has not begun yet.
                      ('b0000000-0000-4000-8000-000000000002',  2,  5, 'CONFIRMED', '4f2c9a1b-7e8d-43c2-9f1e-5a8b7c2d3e4f', '00000000-0000-4000-8000-000000000002'),
                      -- Bob, starts TODAY. Cancelling this must raise LateCancelException, because
                      -- Reservation.transitionTo refuses a cancel on or after start_date.
                      ('b0000000-0000-4000-8000-000000000003',  0,  5, 'CONFIRMED', '4f2c9a1b-7e8d-43c2-9f1e-5a8b7c2d3e4f', '11111111-1111-4111-8111-000000000001'),
                      -- Bob, starts in 9 days: the cancel that is supposed to succeed.
                      ('b0000000-0000-4000-8000-000000000004',  9,  6, 'CONFIRMED', '4f2c9a1b-7e8d-43c2-9f1e-5a8b7c2d3e4f', '11111111-1111-4111-8111-000000000002'),
                      -- Alice, under way.
                      ('b0000000-0000-4000-8000-000000000005', -6, 14, 'CONFIRMED', 'd8b2e1f4-9c3a-4e7f-8a12-6f3b9c8d2e1a', '22222222-2222-4222-8222-000000000001'),
                      -- Alice, upcoming.
                      ('b0000000-0000-4000-8000-000000000006',  4,  9, 'CONFIRMED', 'd8b2e1f4-9c3a-4e7f-8a12-6f3b9c8d2e1a', '22222222-2222-4222-8222-000000000002'),
                      -- Alice, under way.
                      ('b0000000-0000-4000-8000-000000000007', -4,  7, 'CONFIRMED', 'd8b2e1f4-9c3a-4e7f-8a12-6f3b9c8d2e1a', '22222222-2222-4222-8222-000000000004'),
                      -- The blocked account still has a bike out: the block stops the login, not
