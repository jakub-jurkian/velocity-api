    <!-- ═══════════════════════════════════ RESERVATIONS ═══════════════════════════════════
         Wiped and rebuilt on every boot, which is what keeps the demo from rotting: dates are
         derived from CURRENT_DATE each time, so "rented right now" means right now whenever a
         recruiter happens to open the link.

         The wipe is unconditional (DELETE FROM reservations, no WHERE) for a practical reason as
         well as a tidiness one: no_overlapping_active_reservations would reject the re-insert if
         a visitor had booked one of these bikes for overlapping dates. Clearing the table first
         makes the rebuild deterministic instead of occasionally fatal.

         History is written as (months_back, day_off, days) anchored to the start of its own
         month, so each row always lands in the bucket findRevenueTrend groups it into, whatever
         day of the month this runs. day_off + days never exceeds 26, so nothing in the
         months_back = 1 batch can spill into today or the future.

         Everything historical is COMPLETED or CANCELLED, never CONFIRMED: the exclusion
         constraint only covers PENDING/CONFIRMED so finished rentals may stack on one bike, and
         completePastDueConfirmedReservations (01:00 daily) would rewrite any past-dated
         CONFIRMED row anyway.

         total_cost is computed rather than typed, mirroring RentalCostCalculator at the
         daily-rate of 25.00 in application.yml: 25/day up to 7 days, 20/day to 14, then 15.
         Hand-typed numbers would drift from the quote a reviewer gets for the same range.
    -->
    <changeSet author="jakub-jurkian" id="004-prod-demo-reservations" context="prod"
               runAlways="true" runOnChange="true">
        <sql>
            DELETE FROM reservations;
        </sql>
        <sql>
            INSERT INTO reservations (id, start_date, end_date, total_cost, status, cancellation_reason,
                                      created_at, version, user_id, bike_instance_id)
            SELECT s.id,
                   s.start_date,
                   s.start_date + s.days,
                   (s.days * CASE WHEN s.days > 14 THEN 15.00
                                  WHEN s.days > 7 THEN 20.00
                                  ELSE 25.00 END)::numeric(38, 2),
                   s.status,
                   s.reason,
                   ((s.start_date - 5)::timestamp + INTERVAL '9 hours 30 minutes') AT TIME ZONE 'Europe/Warsaw',
                   0,
                   s.user_id,
                   s.bike_id
            FROM (SELECT t.id::uuid AS id,
                         (date_trunc('month', CURRENT_DATE) - (t.months_back || ' months')::interval)::date
                             + t.day_off AS start_date,
                         t.days   AS days,
                         t.status AS status,
                         t.reason AS reason,
                         t.user_id::uuid AS user_id,
                         t.bike_id::uuid AS bike_id
                  FROM (VALUES
                      -- id, months_back, day_off, days, status, cancellation_reason, user, bike
                      ('a0000000-0000-4000-8000-000000000001', 5,  1,  7, 'COMPLETED', NULL::varchar(255), '4f2c9a1b-7e8d-43c2-9f1e-5a8b7c2d3e4f', '11111111-1111-4111-8111-000000000001'),
                      ('a0000000-0000-4000-8000-000000000002', 5,  4, 10, 'COMPLETED', NULL, 'd8b2e1f4-9c3a-4e7f-8a12-6f3b9c8d2e1a', '22222222-2222-4222-8222-000000000001'),
                      ('a0000000-0000-4000-8000-000000000003', 5,  9,  3, 'COMPLETED', NULL, '4f2c9a1b-7e8d-43c2-9f1e-5a8b7c2d3e4f', '11111111-1111-4111-8111-000000000002'),
                      -- Cancelled by the client. ReservationService.cancelReservation never writes
                      -- a reason, so NULL here is what the application itself would have stored.
                      ('a0000000-0000-4000-8000-000000000004', 5, 15,  5, 'CANCELLED', NULL, 'd8b2e1f4-9c3a-4e7f-8a12-6f3b9c8d2e1a', '22222222-2222-4222-8222-000000000003'),
                      ('a0000000-0000-4000-8000-000000000005', 5, 18, 16, 'COMPLETED', NULL, '4f2c9a1b-7e8d-43c2-9f1e-5a8b7c2d3e4f', '11111111-1111-4111-8111-000000000004'),

                      ('a0000000-0000-4000-8000-000000000006', 4,  2,  4, 'COMPLETED', NULL, '4f2c9a1b-7e8d-43c2-9f1e-5a8b7c2d3e4f', '11111111-1111-4111-8111-000000000005'),
                      ('a0000000-0000-4000-8000-000000000007', 4,  6, 14, 'COMPLETED', NULL, 'd8b2e1f4-9c3a-4e7f-8a12-6f3b9c8d2e1a', '22222222-2222-4222-8222-000000000002'),
                      -- The blocked account keeps the rentals it made before it was blocked.
                      ('a0000000-0000-4000-8000-000000000008', 4, 11,  7, 'COMPLETED', NULL, '2a3b4c5d-6e7f-4809-91a2-b3c4d5e6f708', '44444444-4444-4444-8444-000000000001'),
                      ('a0000000-0000-4000-8000-000000000009', 4, 17,  3, 'COMPLETED', NULL, '4f2c9a1b-7e8d-43c2-9f1e-5a8b7c2d3e4f', '11111111-1111-4111-8111-000000000007'),

                      ('a0000000-0000-4000-8000-000000000010', 3,  3, 21, 'COMPLETED', NULL, '4f2c9a1b-7e8d-43c2-9f1e-5a8b7c2d3e4f', '11111111-1111-4111-8111-000000000007'),
                      ('a0000000-0000-4000-8000-000000000011', 3,  5,  6, 'COMPLETED', NULL, 'd8b2e1f4-9c3a-4e7f-8a12-6f3b9c8d2e1a', '22222222-2222-4222-8222-000000000003'),
                      ('a0000000-0000-4000-8000-000000000012', 3, 12,  9, 'COMPLETED', NULL, '4f2c9a1b-7e8d-43c2-9f1e-5a8b7c2d3e4f', '00000000-0000-4000-8000-000000000001'),
