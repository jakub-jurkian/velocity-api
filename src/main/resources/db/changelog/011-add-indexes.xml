<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet author="jakub-jurkian" id="011-add-indexes">
        <createIndex tableName="reservations" indexName="idx_reservations_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="reservations" indexName="idx_reservations_status_created_at">
            <column name="status"/>
            <column name="created_at"/>
        </createIndex>
        <createIndex tableName="bike_instances" indexName="idx_bike_instances_city_status">
            <column name="city"/>
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>